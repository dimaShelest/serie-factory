# Скопіюй у .env і заповни. Файл .env НІКОЛИ не комітимо (він у .gitignore).
# Mac:      cp .env.example .env
# Windows:  Copy-Item .env.example .env

# --- Сценарії (етапи script, shots) — локальна LLM через Ollama (fabrica/local_llm.py) ---
# Ollama має бути запущена. Модель: ollama pull huihui_ai/qwen3.5-abliterated:9b
# Ollama на іншій машині в мережі → її адреса, напр. http://192.168.1.5:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=huihui_ai/qwen3.5-abliterated:9b

# --- Claude API (резерв; переписувач студії при REWRITE_BACKEND=claude — спершу `uv sync --extra claude`) ---
ANTHROPIC_API_KEY=

# --- Студія (`fabrica studio`): хто переписує промпти за відгуком «що не так» — ollama (локально) | claude ---
REWRITE_BACKEND=ollama

# --- Відео (етап video) — Seedance 2.5 через Replicate ---
REPLICATE_API_TOKEN=
SEEDANCE_MODEL=

# --- Відео з обличчям — Seedance 2.5 через Cloudflare Workers AI (use_virtual_avatar) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Профіль довжини кліпу (prompts/providers.yaml → generation): manual-5s — dropshot, кліпи по 5 с ---
GENERATION_PROFILE=manual-5s

# --- Голос (етап voice) — ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Зображення / референси (етап refs) ---
IMAGE_API_KEY=

# --- Lip-sync (етапи video/repair) ---
SYNC_API_KEY=

# --- Сховище медіа — Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Публікація (етап publish) — YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Ліміти витрат, USD (облік витрат). Не задано → платні виклики заборонені; без ліміту — лише `none` ---
BUDGET_PER_EPISODE_USD=160
BUDGET_DAILY_USD=60
BUDGET_MONTHLY_USD=900

# --- Режим «лабораторія промптів»: платні виклики вимкнені, доки люди не затвердять golden-промпти ---
AUTOMATION_ENABLED=false
