# Скопіюй у .env і заповни. Файл .env НІКОЛИ не комітимо (він у .gitignore).
# Mac:      cp .env.example .env
# Windows:  Copy-Item .env.example .env

# --- Сценарії (етапи script, shots) — локальна LLM через Ollama (fabrica/local_llm.py) ---
# Ollama має бути запущена. Модель: ollama pull huihui_ai/qwen3.5-abliterated:9b
# Ollama на іншій машині в мережі → її адреса, напр. http://192.168.1.5:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=huihui_ai/qwen3.5-abliterated:9b

# --- Claude API (резерв) ---
ANTHROPIC_API_KEY=

# --- Відео (етап video) — Seedance ---
SEEDANCE_API_KEY=
SEEDANCE_API_BASE=
SEEDANCE_MODEL=

# --- Голос (етап voice) — ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Зображення / референси (етап refs) ---
IMAGE_API_KEY=

# --- Lip-sync (етапи video/repair) ---
SYNC_API_KEY=

# --- Сховище медіа — Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Публікація (етап publish) — YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Ліміти витрат, USD (облік витрат) ---
BUDGET_PER_EPISODE_USD=
BUDGET_DAILY_USD=
BUDGET_MONTHLY_USD=
